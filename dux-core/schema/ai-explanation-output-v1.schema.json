{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dux:schema:ai-explanation-output:1",
  "title": "DUX AI storage explanation output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task",
    "input_digest_sha256",
    "summary",
    "labels",
    "groups",
    "questions",
    "uncertainties",
    "research_suggestions"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "x-dux-canonicalUnsignedIntegerLexeme": true
    },
    "task": {
      "const": "explain_storage_cluster"
    },
    "input_digest_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "labels": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "groups": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "questions": {
      "$ref": "#/$defs/text_list"
    },
    "uncertainties": {
      "$ref": "#/$defs/text_list"
    },
    "research_suggestions": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/list_text"
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "node_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^n-[a-z0-9][a-z0-9_-]{0,61}$"
    },
    "visible_text": {
      "type": "string",
      "minLength": 1,
      "description": "Explanation-only text: no path-shaped forms, surrounding whitespace, invisible formatting, or cleanup/execution language. Semantic grammar and UTF-8 byte limits are enforced by DUX.",
      "x-dux-forbidsActionLanguage": true,
      "x-dux-forbidsPathLikeText": true,
      "allOf": [
        {
          "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F\\u00AD\\u034F\\u061C\\u180B-\\u180F\\u200B-\\u200F\\u202A-\\u202E\\u2060-\\u206F\\u2044\\u2215\\u29F5\\uFEFF\\uFF0F\\uFF3C/~\\\\]+$"
        },
        {
          "pattern": "^\\S"
        },
        {
          "pattern": "\\S$"
        }
      ]
    },
    "summary": {
      "allOf": [
        {
          "$ref": "#/$defs/visible_text"
        },
        {
          "maxLength": 4096,
          "x-dux-maxUtf8Bytes": 4096
        }
      ]
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$",
      "x-dux-maxUtf8Bytes": 64,
      "x-dux-forbidsActionLanguage": true
    },
    "title": {
      "allOf": [
        {
          "$ref": "#/$defs/visible_text"
        },
        {
          "maxLength": 256,
          "x-dux-maxUtf8Bytes": 256
        }
      ]
    },
    "reason": {
      "allOf": [
        {
          "$ref": "#/$defs/visible_text"
        },
        {
          "maxLength": 1024,
          "x-dux-maxUtf8Bytes": 1024
        }
      ]
    },
    "list_text": {
      "allOf": [
        {
          "$ref": "#/$defs/visible_text"
        },
        {
          "maxLength": 512,
          "x-dux-maxUtf8Bytes": 512
        }
      ]
    },
    "text_list": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/list_text"
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "input_node_ids",
        "reason"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/title"
        },
        "input_node_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/node_id"
          }
        },
        "reason": {
          "$ref": "#/$defs/reason"
        }
      }
    }
  }
}
